# Copy this file to .env and replace example values locally. Never commit .env.

# Laravel application
APP_NAME=QRMetaBucket
DEPLOY_ENVIRONMENT=development
APP_ENV=development
APP_KEY=
APP_DEBUG=false
APP_URL=https://appdev.ft1.us
APP_HOSTNAME=appdev.ft1.us
PUBLIC_SHORT_DOMAIN=dev.ft1.us
SHLINK_DEFAULT_DOMAIN=dev.ft1.us
SHLINK_WEB_HOSTNAME=shlinkdev.ft1.us
SHLINK_SERVER_INTERNAL_URL=http://shlink-server:8080
SHLINK_REST_API_BASE_URL=https://shlinkdev.ft1.us/rest/v3

# PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=qr_meta_bucket
DB_USERNAME=qr_meta_bucket
DB_PASSWORD=replace_with_a_long_random_password

# Shlink
SHLINK_API_KEY=replace_with_shlink_api_key
SHLINK_WEB_CLIENT_IMAGE=shlinkio/shlink-web-client:replace_with_pinned_version
SHLINK_SERVER_IMAGE=shlinkio/shlink:replace_with_pinned_version
SHLINK_DB_DATABASE=shlink_development
SHLINK_DB_USERNAME=shlink_development
SHLINK_DB_PASSWORD=replace_with_a_different_long_random_password

# Optional application API key. This does not authenticate deployments.
GOOGLE_API_KEY=

# Local Google Cloud principal authentication
# Prefer gcloud user authentication or service-account impersonation.
GOOGLE_APPLICATION_CREDENTIALS=
GCP_IMPERSONATE_SERVICE_ACCOUNT=

# Google Cloud project and location
GCP_PROJECT_ID=replace_with_google_cloud_project_id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a

# Artifact Registry
GCP_ARTIFACT_REPOSITORY=qr-meta-bucket
GCP_ARTIFACT_IMAGE=qr-meta-bucket-web
DEPLOY_IMAGE_TAG=replace_with_git_commit_or_release_tag

# Compute Engine
GCP_VM_NAME=qr-meta-bucket-development
GCP_MACHINE_TYPE=e2-small
GCP_BOOT_DISK_SIZE=30GB
GCP_IMAGE_FAMILY=debian-12
GCP_IMAGE_PROJECT=debian-cloud
GCP_STATIC_IP_NAME=qr-meta-bucket-development-ip
GCP_NETWORK_TAG=qr-meta-bucket-development-web
GCP_RUNTIME_SERVICE_ACCOUNT=replace_with_runtime_service_account_email

# Cloud DNS
GCP_MANAGE_DNS=true
GCP_DNS_ZONE=ft1-us
GCP_DNS_DOMAIN=ft1.us.
GCP_DNS_TTL=300

# VM filesystem and deployment behavior
COMPOSE_PROJECT_NAME=qr-meta-bucket-development
DEPLOY_REMOTE_DIRECTORY=/opt/qr-meta-bucket-development
DEPLOY_BACKUP_BUCKET=replace_with_development_backup_bucket_name
DEPLOY_SSH_USER=

# TLS/ACME
ACME_EMAIL=replace_with_certificate_contact_email

# Queue and scheduler
QUEUE_CONNECTION=database

# End of example configuration

# Production uses a separate .env and separate Google VM/Compose stack with:
# DEPLOY_ENVIRONMENT=production
# APP_ENV=production
# APP_URL=https://app.ft1.us
# APP_HOSTNAME=app.ft1.us
# PUBLIC_SHORT_DOMAIN=ft1.us
# SHLINK_DEFAULT_DOMAIN=ft1.us
# SHLINK_WEB_HOSTNAME=shlink.ft1.us
# SHLINK_REST_API_BASE_URL=https://shlink.ft1.us/rest/v3
# GCP_VM_NAME=qr-meta-bucket-production
# GCP_STATIC_IP_NAME=qr-meta-bucket-production-ip
# GCP_NETWORK_TAG=qr-meta-bucket-production-web
# COMPOSE_PROJECT_NAME=qr-meta-bucket-production
# DEPLOY_REMOTE_DIRECTORY=/opt/qr-meta-bucket-production
# Use distinct production DB names, passwords, API keys, disks, and backups.